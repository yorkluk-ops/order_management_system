# Copy to .env and replace every change-me value.
# docker compose reads this file. Use letters and numbers only in passwords
# so DATABASE_URL stays a valid URL (no @ : / # or spaces).
#
# Generate secrets:
#   openssl rand -hex 32

# --- MySQL 8 container (docker compose only) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=oms
MYSQL_USER=oms
MYSQL_PASSWORD=change-me-app

# --- App process ---
# Compose overrides this to mysql://$MYSQL_USER:$MYSQL_PASSWORD@mysql:3306/$MYSQL_DATABASE
# Bare metal (no compose): point it at your own MySQL 8.
DATABASE_URL=mysql://oms:change-me-app@127.0.0.1:3306/oms

# Port the Node process binds. Compose keeps the container on 3000.
PORT=3000

# Host port published on 127.0.0.1 (compose only). Caddy on the VM proxies to it.
APP_PORT=3000

# Signs browser session cookies.
JWT_SECRET=change-me-session-secret

# Bearer token for POST /api/import/orders.
# Leave empty to disable the route (it returns 503 API_KEY_NOT_CONFIGURED).
OMS_IMPORT_API_KEY=

# Browser sign-in when Manus OAuth is not configured. Both are required.
# Runtime only (no image rebuild). Compared exactly after trimming surrounding
# whitespace. Use a long random password; it is not placed in DATABASE_URL,
# so symbols are fine: openssl rand -hex 32
OMS_ADMIN_USERNAME=
OMS_ADMIN_PASSWORD=

# --- Optional. The process boots without these. ---
# Manus OAuth is an alternate sign-in. When both VITE_OAUTH_PORTAL_URL and
# VITE_APP_ID are set at image build time, the login screen shows the Manus
# button instead of the username/password form. OAUTH_SERVER_URL is runtime.
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=

# File upload, stored PDF URLs, maps, and owner notifications (Manus forge).
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=

# Card payments. Unset: the server still starts; /api/stripe/webhook returns 503.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=

# Umami snippet in index.html. Both must be set at image build time or the tag is omitted.
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
